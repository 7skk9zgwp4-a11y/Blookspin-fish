local isFishing = false
fishBtn.MouseButton1Click:Connect(function()
    isFishing = not isFishing
    fishBtn.Text = isFishing and "⚡ تشغيل الأوتو صيد الفوري: (ON)" or "⚡ تشغيل الأوتو صيد الفوري: (OFF)"
    fishBtn.BackgroundColor3 = isFishing and Color3.fromRGB(39,174,96) or Color3.fromRGB(41,128,185)
    
    if isFishing then
        task.spawn(function()
            while isFishing do
                pcall(function()
                    local c = workspace.CurrentCamera.ViewportSize/2
                    -- 1. رمي السنارة فوراً
                    VIM:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0) task.wait(0.05)
                    VIM:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
                    
                    -- 2. توقيت فوري دقيق جداً (أول ما يوصل الأخضر يلقط بالمللي)
                    task.wait(0.5) 
                    
                    -- 3. ضغطة الصيد والتأكيد الفورية
                    VIM:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0) task.wait(0.05)
                    VIM:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
                end)
                
                -- فلترة وتسكيب الأسماك غير المحددة (اللي عليها علامة ❌)
                pcall(function()
                    if p.Backpack then
                        for _, item in ipairs(p.Backpack:GetChildren()) do
                            for fName, keep in pairs(fishList) do
                                if string.find(string.lower(item.Name), string.lower(fName)) and not keep then
                                    item:Destroy()
                                end
                            end
                        end
                    end
                end)
                task.wait(1.2)
            end
        end)
    end
end)

